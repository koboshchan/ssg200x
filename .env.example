CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE
APP_ORIGIN=http://localhost:43891
APP_PORT=43891
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=pokerroom

# Optional. Without a real key forex remains unavailable in production.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Explicit opt-in, including production-style demos. Never inferred from NODE_ENV or credentials.
FX_STREAM_ENABLED=false
# Required stable deployment namespace when enabled; use separate DBs per environment.
FX_STREAM_ENV=

# Application API remains OFF until isolated QA and explicit rollout approval.
APP_API_ENABLED=false
# Generate a stable random value of 32+ characters. Do not rotate with live links.
APP_LINK_HASH_KEY=
# Optional edge-overwritten source-IP header (also used by transfer guessing).
# TRANSFER_TRUSTED_IP_HEADER=
