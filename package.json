{
  "name": "ssg200x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build --webpack",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:finance-retry": "node --experimental-test-module-mocks --import tsx --test tests/pending-finance.test.ts tests/finance-retry-route.test.mts",
    "test:finance-retry:integration": "node --experimental-test-module-mocks --import tsx --test tests/finance-retry-integration.test.mts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:candle-route": "node --experimental-test-module-mocks --import tsx --test tests/candle-route.test.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.17",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@scure/bip39": "^2.4.0",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "lightweight-charts": "^5.2.1",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "pokersolver": "^2.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
